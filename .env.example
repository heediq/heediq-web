# Build-time env vars (Vite inlines VITE_* at build time — never put secrets here).
# Values come from SSM (see README §Deploy) in CI; set locally for `pnpm dev`.
VITE_API_BASE_URL=https://api-dev.heediq.com/api/v1
VITE_WS_BASE_URL=wss://ws-dev.heediq.com
VITE_COGNITO_DOMAIN=https://heediq-dev.auth.eu-west-1.amazoncognito.com
VITE_COGNITO_CLIENT_ID=replace-with-cognito-client-id
# Region for direct calls to the Cognito IdP JSON API (SignUp/InitiateAuth/ForgotPassword —
# D-082). Not derivable from VITE_COGNITO_DOMAIN, which may be a custom domain in prod.
VITE_COGNITO_REGION=eu-west-1
